        "# ================================\n",
        "# 1. INSTALL\n",
        "# ================================\n",
        "!pip install ultralytics -q\n",
        "\n",
        "# ================================\n",
        "# 2. IMPORTS\n",
        "# ================================\n",
        "from ultralytics import YOLO\n",
        "from google.colab import files\n",
        "import os\n",
        "\n",
        "# ================================\n",
        "# 3. UPLOAD FILE (FIXED)\n",
        "# ================================\n",
        "uploaded = files.upload()\n",
        "\n",
        "# 🔥 Safe check (no crash)\n",
        "if not uploaded:\n",
        "    raise Exception(\"❌ Upload failed. Click upload and SELECT best.pt\")\n",
        "\n",
        "# Get filename properly\n",
        "model_path = next(iter(uploaded))\n",
        "print(\"✅ Uploaded:\", model_path)\n",
        "\n",
        "# ================================\n",
        "# 4. LOAD MODEL\n",
        "# ================================\n",
        "model = YOLO(model_path)\n",
        "print(\"✅ Model loaded\")\n",
        "\n",
        "# ================================\n",
        "# 5. EXPORT TO TFLITE\n",
        "# ================================\n",
        "model.export(format=\"tflite\")\n",
        "print(\"✅ Converted to TFLite\")\n",
        "\n",
        "# ================================\n",
        "# 6. DOWNLOAD OUTPUT\n",
        "# ================================\n",
        "tflite_path = None\n",
        "\n",
        "for root, dirs, files_list in os.walk(\"runs\"):\n",
        "    for file in files_list:\n",
        "        if file.endswith(\".tflite\"):\n",
        "            tflite_path = os.path.join(root, file)\n",
        "            break\n",
        "\n",
        "if tflite_path:\n",
        "    print(\"⬇️ Downloading:\", tflite_path)\n",
        "    files.download(tflite_path)\n",
        "else:\n",
        "    raise Exception(\"❌ TFLite file not found\")"
